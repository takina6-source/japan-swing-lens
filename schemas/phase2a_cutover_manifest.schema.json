{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["manifest_version", "implementation_commit_sha", "core_config_sha256", "scope_name", "scope_member_count", "scope_member_sha256", "expected_market_date", "market_session_index", "state_machine_version", "threshold_version", "identity_version", "decision_rule_version", "identity_epoch", "automatic_closed_enabled", "approved_at"],
  "properties": {
    "manifest_version": {"const": "phase2a-cutover-v1"},
    "implementation_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "core_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_name": {"const": "主要500+Growth"},
    "scope_member_count": {"type": "integer", "minimum": 1},
    "scope_member_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_market_date": {"type": "string", "format": "date"},
    "market_session_index": {"const": 0},
    "state_machine_version": {"const": "sm1"},
    "threshold_version": {"const": "smt1"},
    "identity_version": {"const": "csu1"},
    "decision_rule_version": {"const": "idr1"},
    "identity_epoch": {"type": "string", "minLength": 1},
    "automatic_closed_enabled": {"const": false},
    "approved_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}

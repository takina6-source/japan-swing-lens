{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["manifest_version", "asset_name", "asset_sha256", "input_sha256", "expected_market_date", "market_session_index", "run_id", "state_lineage", "state_machine_version", "threshold_version", "seed_manifest", "producer_commit_sha"],
  "properties": {
    "manifest_version": {"const": "phase2a-release-asset-v1"},
    "asset_name": {"type": "string", "pattern": "^phase2a-seed-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9_-]+\\.tar\\.gz$"},
    "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_market_date": {"type": "string", "format": "date"},
    "market_session_index": {"type": "integer", "minimum": 0},
    "run_id": {"type": "string"},
    "state_lineage": {"const": "live-sm1"},
    "state_machine_version": {"const": "sm1"},
    "threshold_version": {"const": "smt1"},
    "seed_manifest": {"type": "object"},
    "producer_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  },
  "additionalProperties": true
}
